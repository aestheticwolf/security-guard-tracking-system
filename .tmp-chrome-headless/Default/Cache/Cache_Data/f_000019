const virtualCameraTerms = [
  "vcam",
  "virtual",
  "obs",
  "snap camera",
  "manycam",
  "xsplit",
  "nvidia broadcast",
  "droidcam",
  "iriun",
  "camo"
];

const preferredCameraTerms = [
  "integrated",
  "built-in",
  "internal",
  "webcam",
  "hd camera",
  "hd webcam",
  "usb camera"
];

const deviceSelectionPrefix = "device:";

export const cameraSelectionModes = {
