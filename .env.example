PORT=5000
JWT_SECRET=change-this-secret-before-production

# Local SQLite fallback. Leave blank to use the default local temp path.
DB_FILE=

# Live database. When MONGODB_URI is set, the backend uses MongoDB instead of SQLite.
MONGODB_URI=
MONGODB_DB_NAME=sentinel_grid

VITE_API_URL=http://localhost:5000/api

# Local selfie fallback. For live permanent selfies, use Cloudinary variables below.
UPLOAD_DIR=./server/uploads/selfies
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sentinel-grid/selfies

# Optional self-hosted face matching with CompreFace.
# Create a Face Verification service in CompreFace and paste its API key here.
COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_API_KEY=
# Recommended for live mobile selfies: accept at 78%+, flag 65-77% for admin review.
COMPREFACE_VERIFY_THRESHOLD=0.78
COMPREFACE_REVIEW_THRESHOLD=0.65
COMPREFACE_TIMEOUT_MS=8000
# How long check-in/check-out waits for an immediate match score before returning.
COMPREFACE_INLINE_TIMEOUT_MS=2500
COMPREFACE_DET_PROB_THRESHOLD=0.8

# Optional: identify this local app to the reverse-geocoding provider.
GEOCODER_USER_AGENT=SentinelGrid/1.0 (local security guard tracking)
