PORT=5000
JWT_SECRET=change-this-secret-before-production

# Local SQLite fallback. Leave blank to use the default local temp path.
DB_FILE=

# Live database. When MONGODB_URI is set, the backend uses MongoDB instead of SQLite.
MONGODB_URI=
MONGODB_DB_NAME=sentinel_grid

VITE_API_URL=http://localhost:5000/api

# Local selfie fallback. For live permanent selfies, use Cloudinary variables below.
UPLOAD_DIR=./server/uploads/selfies
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sentinel-grid/selfies

# Optional: identify this local app to the reverse-geocoding provider.
GEOCODER_USER_AGENT=SentinelGrid/1.0 (local security guard tracking)
